generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String         @id @default(cuid())
  username                String         @unique
  fullName                String
  email                   String?        @unique
  phoneNumber             String?        @unique
  passwordHash            String
  /// VALID VALUES: 'SUPER_ADMIN' | 'AGENCY_OWNER' | 'AGENCY_STAFF' | 'CUSTOMER' (see src/lib/enums.ts UserRole)
  role                    String         @default("CUSTOMER")
  /// VALID VALUES: 'ar' | 'en' | 'fr' (see src/lib/enums.ts UserLanguage)
  language                String         @default("ar")
  avatarUrl               String?
  freeSmsCount            Int            @default(10)
  /// JSON object. VALID KEYS: 'queue_called' | 'turn_approaching' | 'completed' (each boolean)
  notificationPreferences String         @default("{\"queue_called\":true,\"turn_approaching\":true,\"completed\":true}")
  reminderMinutes         Int            @default(10)
  smsNotificationsEnabled Boolean        @default(true)
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  ownedAgencies           Agency[]
  staffAgencies           AgencyStaff[]
  auditLogs               AuditLog[]
  favorites               Favorite[]
  notifications           Notification[]
  reservations            Reservation[]
  smsPurchases            SmsPurchase[]
  managedTransactions     Transaction[]  @relation("ReviewedBy")
  reviews                 Review[]
}

model Agency {
  id                    String          @id @default(cuid())
  name                  String
  nameFr                String?
  nameAr                String?
  customCode            String          @unique
  /// VALID VALUES: 'CLINIC' | 'AGENCY' | 'LAW_FIRM' | 'LABORATORY' | 'GOVERNMENT' | 'OTHER' (see src/lib/enums.ts AgencyCategory)
  category              String
  address               String?
  city                  String          @default("M'Sila")
  wilaya                String          @default("28")
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?
  coverUrl              String?
  description           String?
  descriptionFr         String?
  descriptionAr         String?
  averageServiceTime    Int             @default(10)
  maxActiveReservations Int             @default(50)
  autoPauseWhenFull     Boolean         @default(false)
  isSponsored           Boolean         @default(false)
  /// VALID VALUES: 'BASIC' | 'PREMIUM' | 'ENTERPRISE' (see src/lib/enums.ts SubscriptionTier)
  subscriptionTier      String          @default("BASIC")
  /// VALID VALUES: 'ACTIVE' | 'INACTIVE' | 'TRIAL' | 'EXPIRED' | 'PENDING' (see src/lib/enums.ts SubscriptionStatus)
  subscriptionStatus    String          @default("INACTIVE")
  workingHoursStart     String          @default("08:00")
  workingHoursEnd       String          @default("17:00")
  isQueueOpen           Boolean         @default(true)
  isActive              Boolean         @default(true)
  kioskModeEnabled      Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  ownerId               String
  owner                 User            @relation(fields: [ownerId], references: [id])
  branches              Branch[]
  staff                 AgencyStaff[]
  announcements         Announcement[]
  favorites             Favorite[]
  queueSettings         QueueSettings[]
  reservations          Reservation[]
  services              Service[]
  transactions          Transaction[]
  reviews               Review[]
}

model AgencyStaff {
  id          String   @id @default(cuid())
  userId      String
  agencyId    String
  branchId    String?
  /// VALID VALUES: 'STAFF' | 'MANAGER' | 'OWNER' (see src/lib/enums.ts StaffRole)
  role        String   @default("STAFF")
  permissions String   @default("{\"canManageQueue\":true,\"canManageServices\":false,\"canManageStaff\":false,\"canViewAnalytics\":true,\"canManageBranches\":false,\"canManageWorkingHours\":false,\"canExportData\":false,\"canManageProfile\":false}")
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())
  agency      Agency   @relation(fields: [agencyId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  counters    Counter[]

  @@unique([userId, agencyId])
}

model Service {
  id           String        @id @default(cuid())
  agencyId     String
  name         String
  nameFr       String?
  nameAr       String?
  description  String?
  prefix       String        @default("A")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  agency       Agency        @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, name])
}

model QueueSettings {
  id                   String    @id @default(cuid())
  agencyId             String
  currentServingNumber Int       @default(0)
  lastIssuedNumber     Int       @default(0)
  isPaused             Boolean   @default(false)
  pausedAt             DateTime?
  openedAt             DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  agency               Agency    @relation(fields: [agencyId], references: [id])
}

model Reservation {
  id                  String    @id @default(cuid())
  userId              String?
  agencyId            String
  serviceId           String
  queueNumber         Int
  displayNumber       String
  /// VALID VALUES: 'WAITING' | 'CALLED' | 'SERVING' | 'COMPLETED' | 'CANCELLED' | 'NO_SHOW' (see src/lib/enums.ts ReservationStatus)
  status              String    @default("WAITING")
  estimatedWait       Int?
  reservedDate        String?
  joinedAt            DateTime  @default(now())
  calledAt            DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  rating              Int?
  feedback            String?
  notes               String?
  ratedAt             DateTime?
  reminderSent        Boolean   @default(false)
  reminderSentAt      DateTime?
  smsReminderSent     Boolean   @default(false)
  smsReminderSentAt   DateTime?
  skippedForNoShow    Boolean   @default(false)
  skippedAt           DateTime?
  reclaimRequestedAt   DateTime?
  preferredTime       String?
  fixedTimeEnabled    Boolean   @default(false)
  postponeCount       Int       @default(0)
  isWalkIn            Boolean   @default(false)
  walkInCustomerName  String?
  counterId           String?
  counter             Counter?  @relation("ServedByCounter", fields: [counterId], references: [id])
  currentCounter      Counter?  // Inverse of Counter.currentReservation
  agency              Agency    @relation(fields: [agencyId], references: [id])
  service             Service   @relation(fields: [serviceId], references: [id])
  user                User?     @relation(fields: [userId], references: [id])
  review              Review?

  @@index([agencyId, status])
  @@index([userId, status])
  @@index([serviceId, status])
  @@index([agencyId, status, preferredTime])
}

model Transaction {
  id              String    @id @default(cuid())
  agencyId        String
  amount          Int
  /// VALID VALUES: 'BASIC' | 'PREMIUM' | 'ENTERPRISE' (see src/lib/enums.ts TransactionPlan)
  plan            String
  /// VALID VALUES: 'CCP' | 'BANK_TRANSFER' | 'E_WALLET' | 'CASH' (see src/lib/enums.ts PaymentMethod)
  paymentMethod   String
  receiptUrl      String?
  /// VALID VALUES: 'PENDING' | 'APPROVED' | 'REJECTED' (see src/lib/enums.ts TransactionStatus)
  status          String    @default("PENDING")
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agency          Agency    @relation(fields: [agencyId], references: [id])
  reviewer        User?     @relation("ReviewedBy", fields: [reviewedBy], references: [id])
}

model SmsPurchase {
  id            String   @id @default(cuid())
  userId        String
  quantity      Int
  price         Int
  /// VALID VALUES: 'PENDING' | 'APPROVED' | 'REJECTED' (see src/lib/enums.ts SmsPurchaseStatus)
  status        String   @default("PENDING")
  paymentMethod String?
  receiptUrl    String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// VALID VALUES: 'QUEUE_CALLED' | 'QUEUE_JOINED' | 'QUEUE_COMPLETED' | 'QUEUE_CANCELLED' | 'QUEUE_POSTPONED' | 'QUEUE_TIME_TOGGLE' | 'TURN_APPROACHING' | 'NO_SHOW_WARNING' | 'RESERVATION_CANCELLED' | 'RECLAIM_SUCCESS' | 'CANCELLED' | 'SMS_PURCHASED' | 'RATING_SUBMITTED' | 'QUEUE_WAITING' | 'QUEUE_SERVING' | 'QUEUE_NO_SHOW' (see src/lib/enums.ts NotificationType)
  type      String
  title     String
  message   String   @default("")
  isRead    Boolean  @default(false)
  entityId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([entityId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  agencyId  String
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, agencyId])
}

model Announcement {
  id        String    @id @default(cuid())
  agencyId  String
  message   String
  /// VALID VALUES: 'INFO' | 'WARNING' | 'URGENT' (see src/lib/enums.ts AnnouncementType)
  type      String    @default("INFO")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  agency    Agency    @relation(fields: [agencyId], references: [id])

  @@index([agencyId, isActive])
}

model GlobalAnnouncement {
  id        String   @id @default(cuid())
  message   String
  /// VALID VALUES: 'INFO' | 'WARNING' | 'URGENT' (see src/lib/enums.ts AnnouncementType)
  type      String   @default("INFO")
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SmsSettings {
  id              String   @id @default(cuid())
  /// VALID VALUES: 'algeria_sms' | 'algeria-sms' | 'generic' (see src/lib/enums.ts SmsProvider)
  provider        String   @default("algeria_sms")
  apiUrl          String   @default("")
  apiKey          String   @default("")
  senderName      String   @default("BLASTI")
  enabled         Boolean  @default(false)
  smsPerReminder  Int      @default(1)
  maxSmsPerDay    Int      @default(5)
  testPhoneNumber String?
  // SMS Template fields
  templateTurnApproaching String @default("🔄 BLASTI: Dear {customerName}, your turn is approaching! Ticket {ticketNumber} at {agencyName}. Position: {position}. Est. wait: {estimatedMinutes} min.")
  templateYourTurn        String @default("🎫 BLASTI: Dear {customerName}, it's your turn now! Ticket {ticketNumber} at {agencyName}. Please proceed.")
  templateNoShow          String @default("⚠️ BLASTI: Dear {customerName}, your ticket {ticketNumber} at {agencyName} was skipped due to no-show. You can reclaim your position.")
  templateCustom          String @default("")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  smsLogs         SmsLog[]
}

model SmsLog {
  id            String      @id @default(cuid())
  userId        String?
  phoneNumber   String
  message       String
  /// VALID VALUES: 'PENDING' | 'SENT' | 'FAILED' | 'DELIVERED' (see src/lib/enums.ts SmsLogStatus)
  status        String      @default("PENDING")
  provider      String      @default("")
  errorMessage  String?
  createdAt     DateTime    @default(now())
  smsSettings   SmsSettings? @relation(fields: [smsSettingsId], references: [id])
  smsSettingsId String?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  /// VALID VALUES: 'LOGIN' | 'AGENCY_CREATE' | 'AGENCY_DELETE' | 'USER_SUSPEND' | 'USER_ACTIVATE' | 'USER_DELETE' | 'SETTINGS_UPDATE' | 'QUEUE_CALL' | 'QUEUE_JOIN' | 'QUEUE_POSTPONE' | 'RESERVATION_CANCEL' | 'AUTO_SKIP_NO_SHOW' | 'RECLAIM_POSITION' | 'WALK_IN_ADDED' | 'RATING_SUBMITTED' | 'PAYMENT_APPROVE' | 'PAYMENT_REJECT' (see src/lib/enums.ts AuditLogAction)
  action     String
  /// VALID VALUES: 'USER' | 'AGENCY' | 'RESERVATION' | 'TRANSACTION' (see src/lib/enums.ts AuditLogEntityType)
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Review {
  id            String       @id @default(cuid())
  rating        Int
  comment       String?
  replyText     String?
  repliedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id])
  reservationId String?     @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  @@unique([userId, agencyId])
  @@index([agencyId])
  @@index([userId])
  @@index([createdAt])
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  questionFr  String?
  questionAr  String?
  answer      String
  answerFr    String?
  answerAr    String?
  /// VALID VALUES: 'SUBSCRIPTION' | 'QUEUE' | 'SMS' | 'PAYMENT' | 'GENERAL' (see src/lib/enums.ts FaqCategory)
  category    String   @default("SUBSCRIPTION")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isActive])
  @@index([order])
}

model PaymentSettings {
  id                String   @id @default(cuid())
  ccpEnabled        Boolean  @default(false)
  bankEnabled       Boolean  @default(false)
  electronicEnabled Boolean  @default(false)
  ccpAccount        String   @default("")
  ccpKey            String   @default("")
  bankName          String   @default("")
  bankAccount       String   @default("")
  bankRib           String   @default("")
  ewalletNumber     String   @default("")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  nameFr    String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  isMain    Boolean  @default(false)
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  counters  Counter[]
  staff     AgencyStaff[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

model Counter {
  id                   String       @id @default(cuid())
  number               Int
  name                 String
  nameAr               String?
  nameFr               String?
  isActive             Boolean      @default(true)
  branchId             String
  branch               Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId              String?
  staff                AgencyStaff? @relation(fields: [staffId], references: [id])
  currentReservationId String?       @unique
  currentReservation   Reservation?  @relation(fields: [currentReservationId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  servedReservations Reservation[] @relation("ServedByCounter")

  @@unique([branchId, number])
  @@index([branchId])
}
